module Cairo.ImageSurface;

import Cairo::{
    Format, Surface, Format::stride_for_width, 
    Surface::{_borrow, _borrow_io, _create_from_handle, flush, mark_dirty}
};
import Std::{
    undefined, Array, I32, IO, U8, 
    Array::{@size, _unsafe_grow_size, empty, borrow_elements_io, mutate_elements_io}, 
    Monad::pure, ToCSizeT::c_size_t, ToI32::i32, ToI64::i64
};

create : Format -> (I32, I32) -> IO Surface;
create = |format, (width, height)| (
    let handle = *FFI_CALL_IO[Ptr cairo_image_surface_create(I32, I32, I32), format, width, height];
    Surface::_create_from_handle(handle)
);

get_data : Surface -> IO (Array U8);
get_data = |surface| (
    let bytes = (
        let format = surface.get_format;
        let w = surface.get_width;
        let h = surface.get_height;
        let stride = stride_for_width(format, w);
        stride.c_size_t * h.c_size_t
    );
    surface.flush;;
    surface._borrow_io(|handle|
        let surface_ptr = *FFI_CALL_IO[Ptr cairo_image_surface_get_data(Ptr), handle];
        let (buf, _) = *Array::empty(bytes.i64)._unsafe_grow_size(bytes.i64).mutate_elements_io(|buf_ptr|
            FFI_CALL_IO[() memcpy(Ptr, Ptr, CSizeT), buf_ptr, surface_ptr, bytes]
        );
        pure $ buf
    )
);

write_data : Array U8 -> Surface -> IO ();
write_data = |data, surface| (
    let bytes = (
        let format = surface.get_format;
        let w = surface.get_width;
        let h = surface.get_height;
        let stride = stride_for_width(format, w);
        stride.c_size_t * h.c_size_t
    );
    if data.@size != bytes.i64 {
        undefined("Data length does not match stride * height. Here, stride can be calculated by stride_for_width function.")
    };
    surface._borrow_io(|handle|
        let surface_ptr = *FFI_CALL_IO[Ptr cairo_image_surface_get_data(Ptr), handle];
        data.borrow_elements_io(|data_ptr|
            FFI_CALL_IO[() memcpy(Ptr, Ptr, CSizeT), surface_ptr, data_ptr, bytes]
        );;
        surface.mark_dirty
    )
);

get_format : Surface -> Format;
get_format = |surface| (
    surface._borrow(|handle|
        FFI_CALL[CInt cairo_image_surface_get_format(Ptr), handle].i32
    )
);

get_width : Surface -> I32;
get_width = |surface| (
    surface._borrow(|handle|
        FFI_CALL[CInt cairo_image_surface_get_width(Ptr), handle].i32
    )
);

get_height : Surface -> I32;
get_height = |surface| (
    surface._borrow(|handle|
        FFI_CALL[CInt cairo_image_surface_get_height(Ptr), handle].i32
    )
);