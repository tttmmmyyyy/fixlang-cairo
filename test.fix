module Test;

import Cairo::{Format, Format::{argb, stride_for_width}, clip, in_clip, in_fill, in_stroke, rectangle, set_line_width};
import Cairo.ImageSurface::{create, get_data, write_data};
import Std::{
    Array, Bool, F64, IO, U8, Array::{from_map, @size}, Debug::{assert, assert_eq}, ToI32::i32, ToI64::i64, ToU8::u8
};

test : IO ();
test = test_data;; test_hit_tests;

// An image surface hands back through `get_data` the bytes `write_data` put into it.
test_data : IO ();
test_data = (
    let width = 4;
    let height = 4;
    let stride = stride_for_width(argb, width.i32).i64;
    let written : Array U8 = Array::from_map(stride * height, |i| (i % 251).u8);
    let surface = *create(argb, (width.i32, height.i32));
    surface.write_data(written);;
    let read = *surface.get_data;
    assert_eq(|_| "the length of the data read back", read.@size, written.@size);;
    assert_eq(|_| "the data read back", read, written)
);

// `in_fill`, `in_stroke` and `in_clip` answer true for a point inside the area they name, and false
// for a point outside it.
test_hit_tests : IO ();
test_hit_tests = (
    let surface = *create(argb, (4_I32, 4_I32));
    let cairo = *::Cairo::create(surface);
    cairo.rectangle((1.0, 1.0), (2.0, 2.0));;
    assert(|_| "inside the fill", *cairo.in_fill((2.0, 2.0)));;
    assert(|_| "outside the fill", !*cairo.in_fill((0.5, 0.5)));;
    cairo.set_line_width(0.5);;
    assert(|_| "on the stroke", *cairo.in_stroke((1.0, 2.0)));;
    assert(|_| "off the stroke", !*cairo.in_stroke((2.0, 2.0)));;
    assert(|_| "inside an unset clip", *cairo.in_clip((0.5, 0.5)));;
    cairo.clip;;
    assert(|_| "inside the clip", *cairo.in_clip((2.0, 2.0)));;
    assert(|_| "outside the clip", !*cairo.in_clip((0.5, 0.5)))
);
